# Copiar a `.env` en la raíz del proyecto (el backend lo lee desde ahí).

# === Core ===
ENV=development
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-random-64-hex

# === Database ===
# Postgres local (docker compose up db)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/operacionesrm
# SQLite para desarrollo rápido sin Docker:
# DATABASE_URL=sqlite+aiosqlite:///./local.db

# === Superadmin (SIEMPRE desde env, NUNCA en DB) ===
SUPERADMIN_EMAIL=admin@voicenter.com.py
SUPERADMIN_NAME=Administrador Voicenter
# Opción A (simple): password en plano
SUPERADMIN_PASSWORD=CambiarEstaPassword123!
# Opción B (avanzada): hash bcrypt, dejando SUPERADMIN_PASSWORD vacío
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('TU_PASSWORD'))"
# SUPERADMIN_PASSWORD_HASH=$2b$12$...

# === JWT ===
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# === Login (anti fuerza bruta, por IP + email) ===
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# === Storage ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# === Procesamiento aislado de archivos (liquidaciones) ===
UPLOAD_PROC_TIMEOUT_S=180
UPLOAD_PROC_MEM_MB=0
FACTURACION_WORKER_CONCURRENCY=1

# === Agente de Facturación (OpenAI Agents SDK) ===
# Sin OPENAI_API_KEY el agente se ve pero responde "servidor sin API key".
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.4
AGENT_REASONING_EFFORT=medium
AGENT_REASONING_SUMMARY=auto
AGENT_MAX_HISTORY=20
AGENT_MAX_TOOL_TURNS=30
AGENT_PRICE_INPUT_PER_MTOK=2.50
AGENT_PRICE_CACHED_INPUT_PER_MTOK=0.25
AGENT_PRICE_OUTPUT_PER_MTOK=15.00

# === Logs ===
LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=365

# === CORS (solo relevante si el front corre en otro origen) ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
